# Neon PostgreSQL — get from console.neon.tech
DATABASE_URL=postgresql://user:password@host.neon.tech/notteshe?sslmode=require

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Better Auth public URL — your deployed domain or http://localhost:3000 in dev
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare Images — get from Cloudflare dashboard
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=

# Resend — get from resend.com
RESEND_API_KEY=
EMAIL_FROM=hello@notteshe.com

# Upstash Redis — get from console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
